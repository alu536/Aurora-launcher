{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "mainBinaryName": "Aurora",
  "version": "0.8.0",
  "identifier": "com.aurora.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora Launcher",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "publisher": "Aurora",
    "copyright": "Copyright (c) 2026 Aurora",
    "shortDescription": "Aurora Launcher for Minecraft Java Edition",
    "longDescription": "Aurora is an unofficial launcher for Minecraft Java Edition. It is not affiliated with Mojang Studios or Microsoft.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_FROM_tauri_signer_generate",
      "endpoints": [
        "https://github.com/REPLACE-OWNER/REPLACE-REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
